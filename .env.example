# Copie para .env e preencha. O .env nunca vai para o Git.

# IA para os roteiros (também dá para configurar pela tela IA do app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Instagram (API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8443/contas/instagram/retorno

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Fuso horário da agenda
TZ_AGENDA=America/Sao_Paulo

# E-mail de contato nas páginas /termos e /privacidade
CONTATO_EMAIL=
